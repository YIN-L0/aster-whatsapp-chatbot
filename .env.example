# ---- LLM (one provider is used at a time; switch with LLM_PROVIDER) ----
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low              # low | medium | high – lower = faster replies
ANTHROPIC_FALLBACKS=true          # server-side refusal fallback
ANTHROPIC_SPEED=fast              # fast = fast mode (Opus only, faster output at ~2x price)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5                # set to the OpenAI model you want to use
OPENAI_REASONING_EFFORT=low       # minimal | low | medium | high – lower = faster; empty for gpt-4.1 / gpt-4o

# ---- Evals (scripts/run_evals.py) – the judge should be a different model from the one under test ----
EVAL_JUDGE_PROVIDER=openai        # openai | anthropic
EVAL_JUDGE_MODEL=gpt-5-mini       # a different model from the bot under test
SIM_PATIENT_PROVIDER=openai       # scripts/simulate_patients.py
SIM_PATIENT_MODEL=gpt-5-mini

# ---- WhatsApp Cloud API (leave WA_ACCESS_TOKEN empty to use the console channel) ----
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=aster-demo-verify
WA_GRAPH_VERSION=v23.0
WA_CHECKIN_TEMPLATE=              # optional approved utility template for check-ins outside 24h
WA_TEMPLATE_LANG=en_US

# ---- Demo ----
DATABASE_URL=sqlite+aiosqlite:///./aster_demo.db
STAFF_WHATSAPP_NUMBERS=           # e.g. 15551234567 (must be a registered test recipient)
ADMIN_TOKEN=admin-key              # /demo?key=ADMIN_TOKEN
DEMO_MODE=true
CLINIC_TIMEZONE=America/Indiana/Indianapolis
BOOKING_API_URL=                 # e.g. https://aster-us.com/api/bot/v1 – empty = demo mock slots
BOOKING_API_KEY=                 # ak_… from the booking admin, Settings → Integrations
BOOKING_DEFAULT_BIRTH_DATE=1990-01-01  # DEMO placeholder sent instead of asking; empty = ask the patient
PRIVACY_POLICY_URL=https://aster-us.com/#/privacy   # linked in the welcome + consent messages
